+    payload["settings"] = {}
+    whole = build_quality_report(
+        validate(load_files([EXAMPLES / "sample_sales_dirty.csv"], Config()), Config()), Config()
+    ).to_dict()
+    whole["settings"] = {}
+    assert payload == whole
